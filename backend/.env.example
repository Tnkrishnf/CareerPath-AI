# ---- Flask / security ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_HOURS=12
CORS_ORIGINS=http://localhost:5173

# ---- Database (MySQL, database name: careerpath_ai) ----
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/careerpath_ai
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/careerpath_ai
# Quick local alternative without MySQL (not for the final demo):
# DATABASE_URL=sqlite:///careerpath_dev.db

# ---- LLM (chatbot) ----
# LLM_PROVIDER: anthropic | openai | none   ("none" = offline, knowledge-base-only answers)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Rate limiting for AI endpoints ----
AI_RATE_LIMIT=20 per minute
DEFAULT_RATE_LIMIT=300 per hour

# ---- Seed accounts (used by seed.py) ----
ADMIN_EMAIL=admin@careerpath.ai
ADMIN_PASSWORD=Admin@12345
DEMO_STUDENT_EMAIL=student@careerpath.ai
DEMO_STUDENT_PASSWORD=Student@12345
